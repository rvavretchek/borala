{
  "name": "borala",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "format": "prettier --write app tests cypress .github/workflows package.json tsconfig.json *.ts *.js README.md",
    "format:check": "prettier --check app tests cypress .github/workflows package.json tsconfig.json *.ts *.js README.md",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:architecture": "vitest run tests/architecture",
    "test:e2e:run": "cypress run",
    "test:e2e": "start-server-and-test start http://127.0.0.1:3000 test:e2e:run",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "axe-core": "4.13.0",
    "cypress": "15.19.0",
    "cypress-axe": "1.7.0",
    "eslint": "10.8.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "start-server-and-test": "3.0.12",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.0.16",
    "vitest": "4.1.7"
  }
}
